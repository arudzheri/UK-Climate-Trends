# UK Climate Trends – Analysis Notebook

import pandas as pd
import matplotlib.pyplot as plt

# Load raw data
df = pd.read_csv('../data/raw/annual_mean_temperature.csv')

# Preview
df.head()

# Clean data
df.columns = ['year', 'temperature']
df.dropna(inplace=True)

# Save processed data
df.to_csv('../data/processed/annual_mean_temperature_clean.csv', index=False)

# Plot trend
plt.figure(figsize=(12,6))
plt.plot(df['year'], df['temperature'], marker='o')
plt.title('UK Annual Mean Temperature Trend')
plt.xlabel('Year')
plt.ylabel('Temperature (°C)')
plt.grid(True)
plt.show()

# Rolling average
df['rolling_avg'] = df['temperature'].rolling(window=5).mean()

plt.figure(figsize=(12,6))
plt.plot(df['year'], df['rolling_avg'], color='orange')
plt.title('5-Year Rolling Average Temperature')
plt.xlabel('Year')
plt.ylabel('Temperature (°C)')
plt.grid(True)
plt.show()
